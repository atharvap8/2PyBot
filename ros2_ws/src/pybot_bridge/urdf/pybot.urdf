<?xml version="1.0"?>
<!--
  2PyBot simplified URDF - matches the geometry of
  models/2pybot_simplified.step (1 CAD unit = 100 mm).
  Z-up, X forward. Axle line at z = wheel radius.
-->
<robot name="pybot">

  <material name="teal">
    <color rgba="0.0 0.68 0.71 1.0"/>
  </material>
  <material name="dark">
    <color rgba="0.14 0.16 0.18 1.0"/>
  </material>
  <material name="light">
    <color rgba="0.93 0.93 0.93 1.0"/>
  </material>
  <material name="black">
    <color rgba="0.1 0.1 0.1 1.0"/>
  </material>

  <!-- ================= BASE ================= -->
  <link name="base_link">
    <!-- Lower frame -->
    <visual>
      <origin xyz="0 0 0.017" rpy="0 0 0"/>
      <geometry>
        <box size="0.060 0.124 0.022"/>
      </geometry>
      <material name="dark"/>
    </visual>
    <!-- Main body -->
    <visual>
      <origin xyz="0 0 0.0815" rpy="0 0 0"/>
      <geometry>
        <box size="0.052 0.110 0.107"/>
      </geometry>
      <material name="teal"/>
    </visual>
    <!-- Sensor deck -->
    <visual>
      <origin xyz="0 0 0.1435" rpy="0 0 0"/>
      <geometry>
        <box size="0.058 0.116 0.017"/>
      </geometry>
      <material name="light"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.08" rpy="0 0 0"/>
      <geometry>
        <box size="0.062 0.124 0.150"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.08" rpy="0 0 0"/>
      <mass value="0.9"/>
      <inertia ixx="0.0025" ixy="0" ixz="0" iyy="0.0025" iyz="0" izz="0.0012"/>
    </inertial>
  </link>

  <!-- ================= IMU ================= -->
  <link name="imu_link"/>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0.14" rpy="0 0 0"/>
  </joint>

  <!-- ================= MOTORS (visual only) ================= -->
  <link name="left_motor_link">
    <visual>
      <origin xyz="0 0.020 0" rpy="1.5708 0 0"/>
      <geometry>
        <box size="0.0423 0.040 0.0423"/>
      </geometry>
      <material name="dark"/>
    </visual>
  </link>
  <joint name="left_motor_joint" type="fixed">
    <parent link="base_link"/>
    <child link="left_motor_link"/>
    <origin xyz="0 0.040 0" rpy="0 0 0"/>
  </joint>

  <link name="right_motor_link">
    <visual>
      <origin xyz="0 -0.020 0" rpy="1.5708 0 0"/>
      <geometry>
        <box size="0.0423 0.040 0.0423"/>
      </geometry>
      <material name="dark"/>
    </visual>
  </link>
  <joint name="right_motor_joint" type="fixed">
    <parent link="base_link"/>
    <child link="right_motor_link"/>
    <origin xyz="0 -0.040 0" rpy="0 0 0"/>
  </joint>

  <!-- ================= WHEELS ================= -->
  <link name="left_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.055" length="0.018"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.055" length="0.018"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="4e-5" ixy="0" ixz="0" iyy="4e-5" iyz="0" izz="7.6e-5"/>
    </inertial>
  </link>
  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel_link"/>
    <origin xyz="0 0.080 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="right_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.055" length="0.018"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.055" length="0.018"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="4e-5" ixy="0" ixz="0" iyy="4e-5" iyz="0" izz="7.6e-5"/>
    </inertial>
  </link>
  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel_link"/>
    <origin xyz="0 -0.080 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

</robot>
