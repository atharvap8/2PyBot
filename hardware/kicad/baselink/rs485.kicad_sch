	(text "One transceiver per motor (115200 baud, 10-byte frames every 2.5 ms). Socketed DIP-8 for easy swap. Fail-safe receivers read an"
		(exclude_from_sim no)
		(at 20 25 0)
		(effects
			(font
				(size 1.5 1.5)
				(color 70 70 70 1)
			)
			(justify left bottom)
		)
		(uuid "5d204370-4406-5433-8b45-33d277b5ca1a")
	)
	(text "idle or shorted bus as logic 1, which stops corrupt frames. Fit the 120 Ohm termination jumper at the board end; bias resistors"
		(exclude_from_sim no)
		(at 20 29.5 0)
		(effects
			(font
				(size 1.5 1.5)
				(color 70 70 70 1)
			)
			(justify left bottom)
		)
		(uuid "ea75d90d-ff34-5639-b08a-94beca6f8848")
	)
