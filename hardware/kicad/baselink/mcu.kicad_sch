	(text "STM32G474RET6, 170 MHz Cortex-M4F. USART2/USART3 drive the RS485 links with hardware DE, UART4 is the ELRS CRSF input, USART1"
		(exclude_from_sim no)
		(at 20 25 0)
		(effects
			(font
				(size 1.5 1.5)
				(color 70 70 70 1)
			)
			(justify left bottom)
		)
		(uuid "c5cb0b37-e338-56b2-a7c8-92d5e778ecfa")
	)
	(text "(PA9/PA10) is the Radxa link and also the ROM bootloader port; the Radxa controls BOOT0 and NRST. MOTOR_WDG must be a"
		(exclude_from_sim no)
		(at 20 29.5 0)
		(effects
			(font
				(size 1.5 1.5)
				(color 70 70 70 1)
			)
			(justify left bottom)
		)
		(uuid "2040b133-a180-5261-94cd-4946d9b1c179")
	)
	(text "software-toggled GPIO, never a timer output. Verify the pin map in STM32CubeMX before layout."
