	)
	(text "VMOT is switched by an LM5069 hot-swap (inrush and circuit-breaker limit). It is ON only while MOTOR_EN is high: WDG_OK"
		(exclude_from_sim no)
		(at 20 25 0)
		(effects
			(font
				(size 1.5 1.5)
				(color 70 70 70 1)
			)
			(justify left bottom)
		)
		(uuid "68675d8e-90b0-5fdd-951b-fbacc64ca84a")
	)
	(text "(retriggerable one-shot fed by the control loop toggling MOTOR_WDG; ~20 ms timeout) AND ESTOP_OK (normally-closed E-stop loop)."
		(exclude_from_sim no)
		(at 20 29.5 0)
		(effects
			(font
				(size 1.5 1.5)
				(color 70 70 70 1)
			)
			(justify left bottom)
		)
		(uuid "40fb1de2-cd0d-5aec-a024-842d366284da")
	)
	(text "A stalled MCU, reset, flashing, lost 3V3 or an open E-stop all remove motor power. Q4 only connects the UVLO divider while"
		(exclude_from_sim no)
		(at 20 34 0)
		(effects
			(font
				(size 1.5 1.5)
				(color 70 70 70 1)
			)
			(justify left bottom)
		)
		(uuid "ec51ea87-69a3-5f78-899d-0f77ef9e62da")
	)
	(text "MOTOR_EN is high, so the default state is OFF."
