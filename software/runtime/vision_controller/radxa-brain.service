# radxa-brain.service -- auto-start the robot brain on boot.
# Install:
#   sudo cp radxa-brain.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now radxa-brain
# Logs:  journalctl -u radxa-brain -f
# NOTE: adjust User= and the two paths to where you put the files.
# Under systemd there is no keyboard -- switch modes with the ArUco cards.

[Unit]
Description=2PyBot Radxa brain (collision guard + person follower)
After=multi-user.target

[Service]
Type=simple
User=radxa
WorkingDirectory=/home/radxa/robot
ExecStart=/usr/bin/python3 /home/radxa/robot/radxa_brain.py /dev/ttyUSB0
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
