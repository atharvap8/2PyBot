[Unit]
Description=2PyBot Console (tuning GUI + telemetry + camera API)
After=network.target 2pybot-mediamtx.service
Wants=2pybot-mediamtx.service

[Service]
Type=simple
User=radxa
WorkingDirectory=/home/radxa/2pybot-console
Environment=BOT_SERIAL=/dev/ttyUSB0
Environment=BOT_PORT=8080
Environment=BOT_CAM=/dev/video0
ExecStartPre=/bin/sleep 6
ExecStart=/usr/bin/python3 -m console.server
Restart=always
RestartSec=4

[Install]
WantedBy=multi-user.target
